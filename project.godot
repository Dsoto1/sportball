; Engine configuration file.
; Input actions are generated by tools/generate_input_map.gd; edit the
; binding table there and re-run it rather than hand-editing [input].

config_version=5

[application]

config/name="Sportball"
config/description="Stylized retro-futurist arcade baseball (Phase 0 prototype)."
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
