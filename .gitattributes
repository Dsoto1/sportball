# Normalize text
* text=auto eol=lf

# Large binary art/audio goes through Git LFS (docs/07_TECHNICAL_SPEC.md)
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf.bin filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Small reference images in docs/ are stored as plain git objects so the
# docs read anywhere without LFS (keep them under ~1 MB).
docs/*.jpg -filter -diff -merge binary
docs/*.png -filter -diff -merge binary

# This remote does not accept Git LFS pushes (DECISIONS 2026-10-21), so
# runtime assets are plain git objects under a size budget instead.
assets/** -filter -diff -merge -text
