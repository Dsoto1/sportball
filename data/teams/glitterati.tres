[resource]
script = ExtResource("2_spcjn")
id = &"glitterati"
city = "Neon Heights"
team_name = "Glitterati"
abbreviation = "NHG"
primary_color = Color(0.29411766, 0.16470589, 0.48235294, 1)
secondary_color = Color(0.8509804, 0.6627451, 0.22745098, 1)
accent_color = Color(0.95686275, 0.94509804, 0.98039216, 1)
mascot = "Monsieur Marquee, a top-hatted spotlight"
stadium = "The Halo Dome"
identity = "Glamorous sky-city darlings everyone loves to hate. Power, home runs and bat flips, bought with big contracts. Celebrity showboating: fireworks on every homer and a red-carpet entrance. Their lineup is a running vaudeville act: Who plays first, What is on second, I Don't Know is on third, Why in left, Because in center, Tomorrow pitches and Today catches. Nobody has ever named the right fielder."
rival = &"gearheads"
roster = Array[ExtResource("1_6bpj7")]([SubResource("Resource_ig2kl"), SubResource("Resource_utsep"), SubResource("Resource_pcwrs"), SubResource("Resource_0p3a3"), SubResource("Resource_fji72"), SubResource("Resource_nj2fp"), SubResource("Resource_6xho3"), SubResource("Resource_6jpy8"), SubResource("Resource_k4ys7"), SubResource("Resource_05lvy"), SubResource("Resource_71x34"), SubResource("Resource_fpb3s"), SubResource("Resource_kkpbi"), SubResource("Resource_l55ut"), SubResource("Resource_4vses"), SubResource("Resource_4d3g8"), SubResource("Resource_im68u")])
